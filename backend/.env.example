# --- required ---------------------------------------------------------------
FIRECRAWL_API_KEY=your-firecrawl-key-here

# Embeddings always run on Gemini, so this key is required whichever provider
# generates the answer.
GEMINI_API_KEY=your-gemini-key-here

# --- language model ---------------------------------------------------------
# Which provider writes and grades the answer: gemini | openrouter
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=openrouter. Startup fails without it rather than
# failing on the first request.
# OPENROUTER_API_KEY=your-openrouter-key-here

# Overrides the provider's default model. Leave empty to use the default:
#   gemini     -> gemini-3.6-flash
#   openrouter -> openai/gpt-4o-mini
# LLM_MODEL=

# EMBEDDING_MODEL=models/gemini-embedding-001

# --- http -------------------------------------------------------------------
# Browser origins allowed to call the API. In the Docker setup nginx proxies
# from the same origin, so this only matters for local development.
# CORS_ORIGINS=["http://localhost:5173"]
